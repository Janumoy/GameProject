
# Главное меню:
# чем меньше рассудка тем хуже главное меню (таблетки)
# кнопки разбросанны по главному меню

# На 1 раз буквально 
default RorL = 0
default oo = 0
default X = 0
default DAY1forDoctorR = False


default stress = 5 # Уровень стресса. Влияет на восприятие мира и на концовки. Чем выше, тем хуже последствия.
default insight = 0 # Идем против правил Мамы, Доктора Рэя, Михея. Идем против того, что нам говорят, и пытаемся понять, что происходит на самом деле.
default pills_taken = 0 # Сколько таблеток выпито. Влияет на восприятие мира и на концовки. Чем больше выпито тем "лучше" будут последствия.
default warm = 0 # Неопределенны
default cold = 0 # Неопределенны
default balcony_skipped = False # Проверка условия, если происходит зависания or будет ли диалог с Михеем



# Основные персонажи
define Mila = Character('Мила', color="#ffffff")
define WQe = Character("&???&", color="#3b1e5b", what_font="fonts/&&&.ttf", what_color="#1a0035")

# Второстепенные персонажи
define Mother = Character("Мама", color="#ffffff")
define DoctorR = Character("Доктор Рэй")
define Mihei = Character("Михей")
define Dictor = Character("Диктор")

# Существа/Монстры
define Shadow = Character("Тень")
define Humanoids = Character("Гуманоид")
define Single = Character("Сплетенный")



# init python block
init -2 python:
    renpy.music.register_channel("channel_1", mixer="sfx", loop=False)
    renpy.music.register_channel("channel_2", mixer="sfx", loop=False)
    renpy.music.register_channel("channel_3", mixer="sfx", loop=False)

transform mini_position:
    xpos 100
    ypos 810


##################################################### НАЧАЛО 1 ДНЯ ########################################################################
label start:
    stop music fadeout 1.5
    scene bg white with Fade(2.0, 2.0, 1, color="#ffffff")
    $ renpy.pause(5.0, hard=True)


    scene 1
    play sound clock loop
    # play music guel loop
    show mini_1 at mini_position
    

    "5 ОКТЯБРЯ, ПОНЕДЕЛЬНИК – «Дружба». Утро. Спальня Милы. "
    "(внутренний голос, вязко, как будто идешь через болото)"
    Mila "Восемь утра. Или восемь вечера? За окном всегда осень, так что не понять. Главное — слышать, как мама что-то делает на кухне. Когда она затихает — тогда страшно." 
    Mila "Тогда стены неистественно для себя начинают как будто бы слушать. А они слушают всегда. Просто я этого не замечала."
    "Мила сидит на кровати. Простыня подозрительно липнет к телу — не от пота, а от того, что под матрасом кто‑то дышит. Тихо, ритмично. Она уже привыкла к таким ситуациям. Сегодня дыхание ровнее, чем вчера — может, мама дала меньшую дозу перед сном? Кто знает, кто знает."
    "В комнате пахнет пылью, старым чаем и чуть заметной струйкой корицы из кухни. Свет из окна — бледный и тонкий, будто через марлю. Всё кажется чуть приукрашенным, как старая фотография, которую долго держали в руках."
    "На тумбочке — пустой стакан. На дне осталась розовая на вид плёнка. Таблетка «Дружба» растворяется так, что не отмыть."
    play channel_1 door
    "(через дверь, голос тёплый, чуть приглушенный, как со сна)"
    Mother "Миля? Я сварила кофе. Тот, с корицей, твой любимый."
    "(не открывая глаза)"
    Mila "Спасибо, Ма. Сейчас..."
    play channel_1 bedsheet
    scene 3
    "Она не смотрит в зеркало. В зеркале её отражение иногда моргает с задержкой – на секунду позже, чем она сама."
    "В прошлый раз, когда она посмотрела, отражение улыбнулось, хотя Мила не улыбалась. С тех пор она закрывает зеркало полотенцем."
    "(поднимается, на ощупь ищет тапки)"
    Mila "Под кроватью кто-то постоянно скребётся. Но я знаю: если посмотрю, там будет пусто. Пустота как оказалось тоже умеет скрестись."
 
    stop sound
    stop music
    jump one
label one:
 
    scene 4
    play channel_1 door1 
    "Мила выходит из комнаты и на секунду замирает. Её встречает коридор — узкий и знакомый, с половицы, которые скрипят под каждым шагом. Свет в коридоре моргает, лампочка низко висит и отбрасывает длинные тени по обоям."
    "На правой стене, между туалетом и ванной, появилась незнакомая трещина. Или она всегда была там? На краю трещины обои кажутся выгоревшими, будто кто‑то проводил пальцем по бумаге."
    "Она останавливается перед трещиной. Та тянется от плинтуса до потолка, тонкая, как паутина, и при ближайшем рассмотрении кажется, что в ней таится тонкий белый пыльный след."
    "Если прислушаться — из трещины доносится слабый, едва уловимый звук, похожий на скрежет труб или на то, как кто‑то медленно чёркает ногтем по стеклу. Это не пугает так, как притягивает — как будто она должна узнать этот звук."

    jump two
label two:
    scene 5
    play channel_1 kapli loop volume 0.2
    play music ten loop volume 1.0 fadein 1.0 fadeout 1.0
    "Линолеум кажется липким даже через тапки. Мама стоит у плиты – халат в мелкий цветочек, волосы собраны в небрежный пучок, на затылке выбиваются седые пряди."
    "На вид – обычная уставшая женщина сорока с лишним лет."
    scene 6
    "Мила подходит к столу и видит кружку с кофе. Только он пахнет не только корицей, но и чем-то отдалённо похожим на гнилое, если принюхаться. Мила не принюхивается."
    "Рядом с кружкой – две таблетки на блюдце: большая белая ужасно шершавая, как таблетки от давления, и маленькая розовая приятно гладкая, блестящая."
    "Рядом – стакан воды. На дне почему-то плавает чёрная нитка. Мила смотрит на неё. Нитка медленно извивается."
    play channel_3 skripchair
    scene 7
    play channel_2 chairspeaker
    "(садится напротив. У неё мешки под глазами, но голос бодрый)"
    Mother "Ты вообще сегодня спала?"
    Mila "Вроде да, а вроде нет. Мне снилось метро. Но без людей. Только эскалаторы, которые едут вверх, а ведут вниз. И на каждой ступеньке – чей-то ботинок. Пустой."
    "Мама на секунду замирает. Её пальцы сжимают кружку – костяшки белеют. Потом она улыбается – слишком быстро и слишком широко, как кукла, у которой дёргают ниточку."
    Mother "Это просто сон. Рэй сказал, сейчас нервная система восстанавливается. Поэтому он и усилил рецепт таблеток."
    "Мила переводит взгляд на таблетки. Белая отдаёт запахом пыльцы. Розовая – металлом и чем-то сладким, как старый мёд."
    "На розовой выгравирован крошечный символ: глаз в треугольнике. Мила проводит по нему ногтем – чувствует углубление."
    Mila "Мам… ты тоже их пьёшь?"
    "Мама замолкла. Смотрит на таблетки, потом на Милу. В её глазах мелькнуло что-то странное – не страх, не гнев, а что-то немыслимое и усталое."
    "Она не отвечает сразу. Кажется, она пытается подобрать слова, но в итоге просто отводит взгляд."
    "Пауза. Слишком долгая. На кухне что-то щёлкает – то ли холодильник врубился, то ли скелет в стене переступил с ноги на ногу. Мама смотрит в окно, на галок. Галки сидят на проводах – ровно три, как всегда."
    "(тихо, почти шёпотом)"
    play channel_2 chairspeaker
    play channel_3 whisper volume 0.01
    Mother "Я пью другое. Мне не нужно видеть то, что видишь ты. Мне достаточно быть рядом."
    "Она протягивает руку и накрывает ладонь Милы своей. Ладонь нормальная – тёплая, чуть шершавая от мытья посуды. Но под ногтями – чёрное. Не грязь. Что-то, что растёт изнутри, как корень."
    "Мила смотрит на эти чёрные нити. Они пульсируют в такт её собственному сердцу – или маминому?"
    "Внутри неё поднимается что-то, похожее на страх, но приправленное странной нежностью."
    Mila "Они… растут? У тебя под ногтями?"
    Mother "Это плата, котёнок. Но не бойся. Я уже привыкла."
    "Мама сжимает её ладонь чуть сильнее. Её голос становится тише, почти шёпотом, в котором слышна усталость веков."
    Mother "Не думай. Выпей, Милуш. Ради меня."
    "Она просит меня пить. Всегда просит. А что, если я не выпью? Что тогда?" 

    menu:
        "Выпить таблетки.":
            $ RorL = RorL + 1
            $ pills_taken = pills_taken + 1
            $ stress = stress + 2
            "Мила глотает их по очереди — сначала белую, ощущая, как таблетка шершавит горло, оставляя на нёбе тонкую корку тревоги."
            scene 8
            play channel_2 pills
            "(она застревает в горле, приходится запить; вода вниз проходит тяжёлой, как маленький ритуал)"
            "Потом розовую — она тает быстрее, как будто растворяет отдельную нить в её сознании."
            scene 9
            play channel_3 pills
            "(розовая оставляет привкус подслащённой меди, который остаётся на языке на несколько дыханий)."
            "Мир становится тёплым, как после хорошего сна: углы смягчаются, предметы теряют острые углы. Линолеум — просто линолеум, пятнистый и старый. Кран не сочится, стены не дышат."
            "Даже галки за окном кажутся обычными птицами, а не посланниками — и это даёт ощущение простого мира, которое она давно не помнила."
            "Мама улыбается — нормальной улыбкой, без излишней натуги; её глаза смягчаются на миг, и на лице появляется то, что можно назвать покоем."
            Mother "Вот и умница. Сегодня будет хороший день."
            $ X = X + 1
            stop channel_1
            jump threeI

        "Отказаться.":
            $ insight = insight + 1
            $ stress = stress - 1
            "Мила медленно убирает руку. Кладёт ладонь на стол – там, где чёрная нитка под стеклом. Нитка замирает."
            Mila "Я… попозже. Желудок болит."
            "Мама не меняется в лице, но её глаза становятся влажными — странно нежные и пустые одновременно, как у старой куклы, которую моют под краном. В её губах застревает слово, которое она сдерживает."
            Mother "Как хочешь, милая. Но тогда без прогулки сегодня. И без вечернего чая с печеньем."
            "Она забирает таблетки. Кладёт их в карман халата так, будто прячет не таблетки, а малую часть мира, который ещё остался ей доверить. Карман не оттопыривается — таблетки уходят внутрь, будто в бездонную яму."
            stop music fadeout 1.0
            stop channel_1
            jump three

        "Поинтересоваться...?.":
            $ insight = insight + 1
            Mila "А что будет, если я не выпью ни сегодня, ни завтра? Что тогда?"
            "Мама замирает. Её улыбка держится, но глаза пустеют – как у рыбы на прилавке."
            Mother "Тогда ты увидишь меня настоящую. И перестанешь спать. Совсем. А когда человек не спит десять дней – он… перестаёт быть человеком."
            "Она убирает таблетки не в карман, а в рот – глотает сама, сухо, даже не поморщившись."
            Mother "Я тоже иногда боюсь. Поэтому пью. Вместе мы – нормальные. Хочешь быть нормальной?"
            "Её голос дрожит оттого, что страх и привычка переплелись; она улыбается и делает это легко, но в её пальцах видно напряжение, словно эта ритуальность держит её на месте."

            menu:

                "Согласиться и выпить таблетки.":
                    $ X = X + 1
                    $ pills_taken = pills_taken + 1
                    $ stress = stress + 2
                    play channel_3 pills
                    "Мила кивает, берёт таблетки и глотает. Мир смягчается, становится вязким."
                    Mother "Вот и славно."
                    stop music fadeout 1.0
                    stop channel_1
                    jump three

                "Снова отказаться.":
                    $ insight = insight + 1
                    $ stress = stress - 1
                    Mila "Нет. Я не хочу быть нормальной. Я хочу знать."
                    Mother "Тогда пеняй на себя."
                    "Мама выходит из кухни, оставив Милу одну в комнате."
                    stop music fadeout 1.0
                    stop channel_1
                    jump three
    
label threeI:
    scene 10
    if X >= 1:
        menu:
            "Мила смотрит в окно. На скамейке старуха кормит голубей. Только начинается день, солнце уже взошло."

            "Задать вопрос о таблетках" if RorL == 1:
                $ stress = stress - 1
                "(держа в руке упаковку таблеток разных цветов)"
                Mila "А что будет, если я перестану их выпивать, то что тогда?"
                "Мама замирает. Её улыбка держится, но глаза пустеют – как у рыбы на прилавке."
                "(очень ровно, будто зачитывает инструкцию)"
                Mother "Тогда ты увидишь меня настоящую. И перестанешь спать. Совсем. А когда человек не спит десять дней – он… перестаёт быть человеком."
                Mila "..."
                Mila "Ладно, я тогда пойду к себе в комнату."
                scene 11
                "Идя по коридору, Мила прокручивала все варианты в голове: от самого простого до абсурдного, и каждый раз сердце делало маленькое усилие — то ли от надежды, то ли от страха. Она шла медленно, считая шаги, как будто считая возможные исходы."
                stop music fadeout 1.0
                jump three
                
            "Промолчать":
                $ stress = stress + 1
                Mila "..."
                jump lo



screen timerr:
    timer 1 repeat True action If(countdown > 0, SetVariable("countdown", countdown - 1), [Hide("timerr"), Jump("zavisanie")])
    text str(countdown) xalign 0.5


label lo:
    $ countdown = 15
    show screen timerr
    menu:
        Mother "Зачем ты делаешь меня несчастной? Я тоже иногда боюсь, Но все равно  пью. Вместе мы – нормальные. Ты хочешь быть нормальной?"

        "Если так нужно...":
            play channel_3 pills
            "Мила глотает их по очереди – сначала белую (она застревает в горле, приходится запить), потом розовую (та мгновенно тает на языке, оставляя привкус подслащённой меди)."
            "Мир становится тёплым, как после хорошего сна. Линолеум – просто линолеум, пятнистый, старый. Кран не сочится, стены не дышат. Даже галки за окном кажутся обычными птицами, а не посланниками."
            "Мама улыбается – нормальной улыбкой, не гипертрофированной. Морщинки собираются у глаз."
            $ stress = stress + 2
            $ pills_taken = pills_taken + 1
            $ RorL = RorL + 1
            hide screen timerr
            stop audio
            stop music fadeout 1.0
            stop sound
            stop voice
            stop channel_1
            stop channel_2
            stop channel_3
            jump three

        "Давай попозже, мне нужно подумать.":
            $ stress = stress - 1
            $ insight = insight + 1
            "Мила ушла в комнату"
            hide screen timerr
            stop audio
            stop music fadeout 1.0
            stop sound
            stop voice
            stop channel_1
            stop channel_2
            stop channel_3
            jump three


label zavisanie:
    $ renpy.pause(10.0, hard=True)
    $ balcony_skipped = True
    $ stress = stress + 2
    $ DAY1forDoctorR = True
    #Приход Рэя раньше положенного 
    WQe "Но никто не пришел."
    stop audio
    stop music fadeout 1.0
    stop sound
    stop voice
    stop channel_1
    stop channel_2
    stop channel_3


#День. Комната Милы (после завтрака). Если приходит Рэй = скип до four
